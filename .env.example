# ============================================================================
# hyper-go — Environment Configuration
# Loaded automatically from .env on startup (see core/envload.go).
#
# Every value below is EMPTY by default: hyper-go ships with no credentials
# and no third-party endpoints baked in. Copy this file to `.env` and fill in
# only what you actually need — a feature whose endpoint is empty stays
# disabled and returns a clear "not configured" message instead of failing
# at runtime.
#
#   cp .env.example .env
# ============================================================================

# ─── Owner (required) ───────────────────────────────────────────────────
# At least one of OWNER_JID / OWNER_LID must be set, otherwise nobody can
# run owner-only commands.
#
# Classic JID (phone number). Comma-separated for multiple owners.
# Example: 6281234567890  or  6281234567890@s.whatsapp.net
OWNER_JID=

# LID of the owner (useful when messages arrive as @lid instead of @s.whatsapp.net).
# Example: 123456789012345  or  123456789012345@lid
OWNER_LID=

# Display name used by the bot when it greets the owner.
OWNER_NAME=

# Name the bot announces itself with.
BOT_NAME=


# ─── Storage ────────────────────────────────────────────────────────────
# Backend selection:
#   postgres → PostgreSQL (requires POSTGRES_DSN)
#   sqlite   → SQLite file (zero-config, default)
#   auto     → PostgreSQL when POSTGRES_DSN is set, else SQLite (default)
STORAGE=auto

# PostgreSQL connection string. Ignored when STORAGE=sqlite.
# Example: postgres://user:password@localhost:5432/botdb?sslmode=disable
POSTGRES_DSN=

# SQLite database file. Used for BOTH the WhatsApp session store and the
# bot's own tables, so the whole state lives in one portable file.
# Default: ./data/bot.db
SQLITE_DB=

# Legacy alias for SQLITE_DB (kept for compatibility).
SESSION_DB=


# ─── Web UI (QR pairing) ────────────────────────────────────────────────
# Port of the local web UI that shows the QR code. Default: 3000
WEB_PORT=

# Path of the .env file to read. Default: .env
ENV_FILE=


# ─── Owner tools ────────────────────────────────────────────────────────
# Set to "1" to let .shell run arbitrary commands (default: an allowlist).
SHELL_ALLOW_ALL=

# Extra directory .getfile is allowed to read from (besides the working dir).
# OWNER_EXTRA_FILE_ROOT=/var/log


# ─── Lacak (OSINT tracker) ──────────────────────────────────────────────
# HTTP tracker port. Default: 24724
LACAK_PORT=

# Publicly reachable base URL used for the tracker image.
LACAK_PUBLIC_URL=


# ─── Game / WS server ───────────────────────────────────────────────────
# WebSocket server port (game server, live streaming). Default: 24848
GAME_PORT=

# Publicly reachable base URL of the WebSocket server.
GAME_PUBLIC_URL=


# ─── AI backends ────────────────────────────────────────────────────────
# Groq (OpenAI-compatible). The key is required for the AI commands.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Base URL of the Groq API.
GROQ_API_BASE=

# OpenAI-compatible text completion endpoint (used as an AI fallback).
POLLINATIONS_BASE=

# Gemini web client (no API key, uses a session cookie).
GEMINI_BASE=


# ─── Media / download endpoints ─────────────────────────────────────────
# Download worker (aiodl-style API).
DL_BASE_URL=

# Media / metadata API.
KANGWIFI_API_BASE=

# TikTok / Instagram / Facebook downloader.
TIKWM_API_BASE=

# cobalt media downloader.
COBALT_API_BASE=

# Fallback media downloader.
VIDEODOWNLOADERTOOLS_BASE=

# YouTube Music download worker.
YT_LOADER_BASE=

# Spotify oEmbed metadata (used for track previews).
SPOTIFY_OEMBED_BASE=

# Alight Motion template renderer service.
AMWEB_API=


# ─── Misc integrations ──────────────────────────────────────────────────
# Geo-IP lookup.
IP_API_BASE=

# Lyrics lookup.
LRCLIB_BASE=

# URL shortener.
SHORTLINK_BASE=

# Remote notice / ad source.
ADS_SOURCE_URL=

# Google Translate text-to-speech.
GOOGLE_TTS_BASE=

# Google Identity Toolkit + Secure Token (used by the Alight Motion flow).
GOOGLE_IDENTITY_BASE=
GOOGLE_SECURETOKEN_BASE=

# Alight Motion API key, base URL and purchase-verification endpoint.
ALIGHT_API_KEY=
ALIGHT_BASE=
ALIGHT_VERIFY_URL=

# YouTube Music download API key.
YTMUSIC_DL_API_KEY=

# Host allowed to serve rich-card media. Default: localhost
RICH_CARD_TRUSTED_SOURCE=

# UI catalog used by the A2UI renderer. Default: the public A2UI v0.9 catalog.
A2UI_CATALOG_URL=

# Path to a Chrome/Chromium binary used for headless rendering.
CHROME_HEADLESS_SHELL=


# ─── Network ────────────────────────────────────────────────────────────
# Optional SOCKS5 proxy for outbound traffic (host:port or a full URL).
SOCKS5_PROXY=

# Standard proxy variables are honoured as well.
# https_proxy=
# HTTP_PROXY=
